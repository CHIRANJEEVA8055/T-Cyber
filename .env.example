# SQLite database file (relative to the project root).
DATABASE_URL="file:./data/t-cyber.db"

# Directory for uploaded evidence originals. Must NOT be inside /public.
STORAGE_DIR="./data/storage"

# Used to sign nothing sensitive in this demo; sessions are random tokens stored hashed in the DB.
SESSION_SECRET="local-demo-only-change-me"

# Disable outbound telemetry from Next.js and Prisma so the demo makes no unintended external calls.
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1

# Mailing approved requests to the IO's mailbox (config/t-cyber.config.json: delivery.transport "smtp").
# Leave unset while delivery.transport is "simulated" (the default: the mail is kept in T-CYBER).
# SMTP_SECURE: "starttls" (port 587), "tls" (port 465), or "none" for a relay on this server (127.0.0.1) only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=starttls
# SMTP_USER=
# SMTP_PASS=
